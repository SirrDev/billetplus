# Normalise les fins de ligne indépendamment de l'OS du contributeur
# (poste Windows en développement, Linux en CI) : évite le bruit de diff
# LF vs CRLF dans les pull requests.

* text=auto eol=lf

# Les scripts shell doivent impérativement rester en LF, même générés sous Windows —
# un CRLF dans un script bash le casse silencieusement en environnement Linux/CI.
*.sh text eol=lf

# Le wrapper Maven est un script shell malgré l'absence d'extension .sh
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binaires — jamais de conversion de fins de ligne.
# (.docx est une archive ZIP : une conversion la corromprait.)
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.jar binary
*.pem binary
*.docx binary
