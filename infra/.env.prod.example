# Modèle des variables de production. Copier en infra/.env.prod (ignoré par Git),
# puis remplir chaque valeur. Ne jamais commiter infra/.env.prod.
#
# Générer un secret aléatoire (PowerShell) :
#   [Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Maximum 256) }))

# PostgreSQL
DATABASE_NAME=billetplus
DATABASE_USERNAME=billetplus
DATABASE_PASSWORD=

# Redis (obligatoire : Redis porte les réservations de places)
REDIS_PASSWORD=

# Secret de signature des jetons JWT : au moins 32 octets, propre à la production
JWT_SECRET=

# Passerelle UnitechPay (ADR 0007) : clé du tableau de bord, Paramètres > API.
# Elle donne accès aux fonds et signe les webhooks : secret critique.
UNITECHPAY_API_KEY=
# Pages de la PWA après paiement ou annulation ; {orderId} est remplacé (facultatif)
UNITECHPAY_URL_RETOUR_SUCCES=
UNITECHPAY_URL_RETOUR_ANNULATION=

# Premier compte ADMIN (facultatif ; vider après le premier démarrage)
BILLETPLUS_ADMIN_EMAIL=
BILLETPLUS_ADMIN_MOT_DE_PASSE=

# Port local du backend, derrière le proxy TLS
BACKEND_PORT=8080

# Clés Ed25519 : pas de variable ici. Déposer la paire de PRODUCTION dans
# infra/secrets/ed25519_private.pem et infra/secrets/ed25519_public.pem
# (ignorés par Git). La clé publique est aussi celle de la PWA scanner.
